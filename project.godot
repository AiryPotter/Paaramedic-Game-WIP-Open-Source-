; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Paramedic Simulator"
run/main_scene="res://scenes/ui/main_menu.tscn"
config/features=PackedStringArray("4.7", "Mobile")
config/icon="res://icon.svg"

[autoload]

GameState="*res://scripts/game/game_state.gd"

[editor]

movie_writer/disable_vsync=true

[input_devices]

pointing/ios/enable_pan_and_scale_gestures=true
sensors/enable_accelerometer=true
sensors/enable_gravity=true
sensors/enable_gyroscope=true
sensors/enable_magnetometer=true

[internationalization]

locale/include_text_server_data=true

[rendering]

renderer/rendering_method="mobile"

[xogot]

project/editorState=[{
"column": 0,
"current": true,
"line": 452,
"path": "res://tests/qa_runner.gd",
"transient": true,
"type": "file"
}]
project/shaderEditorState=[]
project/breakpoints={}
project/disabled_breakpoints={}

[xr]

openxr/extensions/debug_utils=0
